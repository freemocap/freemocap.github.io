# 301 redirects from the legacy docs.freemocap.org/documentation/* URLs to their
# V2 pages. Plain Apache mod_alias, so it works without JavaScript and passes
# search ranking to the new URLs. Mapping and rationale: DEPLOY-PLAN.md.
Redirect 301 /documentation/index_md.html /
Redirect 301 /documentation/installation.html /start/install/
Redirect 301 /documentation/software-hardware-prerequisites.html /reference/system-requirements/
Redirect 301 /documentation/multi-camera-calibration.html /tutorials/calibrate/
Redirect 301 /documentation/single-camera-recording.html /tutorials/single-camera/
Redirect 301 /documentation/calibration-troubleshooting.html /guides/calibration-troubleshooting/
Redirect 301 /documentation/installation-troubleshooting.html /guides/installation-troubleshooting/
Redirect 301 /documentation/frequently-asked-questions-faq.html /guides/faq/
Redirect 301 /documentation/code-of-conduct.html /about/code-of-conduct/
Redirect 301 /documentation/contributing-index.html /build/contributing/
